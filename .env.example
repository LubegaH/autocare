# Local values are printed by `npm run db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Optional. Keep empty during local development unless testing monitoring.
VITE_SENTRY_DSN=

# Edge Function configuration. Set these with `supabase secrets set` in hosted
# environments; never prefix server secrets with VITE_ or commit real values.
APP_URL=http://127.0.0.1:5173
RESEND_API_KEY=
RESEND_FROM_EMAIL=
